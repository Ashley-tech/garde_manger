<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewPasswordActivity">

    <TextView
        android:id="@+id/logonewpassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Garde-manger"
        android:textColor="@color/bleu_nav"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/titlenewpassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titlenewpassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Réinitialisation de votre mot de passe"
        android:textSize="15dp"
        app:layout_constraintTop_toBottomOf="@id/logonewpassword"
        app:layout_constraintBottom_toTopOf="@+id/labelmel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/labelmel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mail : "
        app:layout_constraintTop_toBottomOf="@id/titlenewpassword"
        app:layout_constraintBottom_toTopOf="@+id/editTextNewPasswordForgot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextNewPasswordForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Nouveau mot de passe*"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/labelmel"
        app:layout_constraintBottom_toTopOf="@+id/editTextNewPasswordReconfirmForgot"
        app:layout_constraintEnd_toStartOf="@+id/newpwddisplaybutton"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/newpwddisplaybutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/grey_7"
        android:text="Dé-masquer"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelmel"
        app:layout_constraintStart_toEndOf="@id/editTextNewPasswordForgot"
        app:layout_constraintBottom_toTopOf="@id/newpwdrdisplaybutton"/>

    <EditText
        android:id="@+id/editTextNewPasswordReconfirmForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Mot de passe à reconfirmer*"
        android:inputType="textPassword"
        app:layout_constraintBottom_toTopOf="@+id/retour_button_new_password"
        app:layout_constraintEnd_toStartOf="@+id/newpwdrdisplaybutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextNewPasswordForgot"/>

    <Button
        android:id="@+id/newpwdrdisplaybutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/grey_7"
        android:text="Dé-masquer"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/editTextNewPasswordReconfirmForgot"
        app:layout_constraintTop_toBottomOf="@id/newpwddisplaybutton"
        app:layout_constraintBottom_toTopOf="@+id/change_pwd_button"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/retour_button_new_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/grey_white_ea"
        android:text="Retour"
        android:textColor="@color/bleu_nav_2"
        app:layout_constraintTop_toBottomOf="@id/editTextNewPasswordReconfirmForgot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/change_pwd_button"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/change_pwd_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/bleu_nav_2"
        android:text="Modifier le mot de passe"
        android:textColor="@color/grey_white_ea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/retour_button_new_password"
        app:layout_constraintTop_toBottomOf="@id/newpwdrdisplaybutton" />
</androidx.constraintlayout.widget.ConstraintLayout>